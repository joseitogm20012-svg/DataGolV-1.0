<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container my-4 flex-grow-1" style="max-width: 950px;">
    <div class="mb-3">
        <a href="/" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left me-1"></i> Volver al listado</a>
    </div>

    <!-- Tarjeta Principal del Partido -->
    <div class="card bg-dark-subtle border-secondary border-opacity-50 shadow-lg rounded-4 overflow-hidden mb-4">
        <!-- Banner de Cabecera -->
        <div class="bg-gradient bg-dark p-4 border-bottom border-secondary border-opacity-25 text-center position-relative">
            <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-50 px-3 py-1 mb-2">
                <i class="bi bi-trophy-fill text-warning me-1"></i> <%= prediction.liga %>
            </span>
            <div class="text-muted small">
                <i class="bi bi-calendar-event me-1"></i> <%= new Date(prediction.fechaPartido).toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
            </div>

            <!-- Marcador Principal -->
            <div class="row align-items-center justify-content-center my-4">
                <div class="col-5 text-end">
                    <h2 class="display-6 fw-bold mb-0 text-light"><%= prediction.equipoLocal %></h2>
                    <span class="text-muted small"><i class="bi bi-house-door me-1"></i>Local</span>
                </div>
                <div class="col-2 text-center">
                    <div class="display-4 fw-bold text-success bg-black px-3 py-2 rounded-3 border border-success border-opacity-50 shadow d-inline-block">
                        <%= prediction.golesLocalPredicho %> - <%= prediction.golesVisitantePredicho %>
                    </div>
                    <div class="extra-small text-uppercase tracking-wider text-muted mt-1">Marcador Estimado</div>
                </div>
                <div class="col-5 text-start">
                    <h2 class="display-6 fw-bold mb-0 text-light"><%= prediction.equipoVisitante %></h2>
                    <span class="text-muted small"><i class="bi bi-airplane me-1"></i>Visitante</span>
                </div>
            </div>

            <!-- Estado -->
            <span class="badge fs-6 px-3 py-2 <%= prediction.estado === 'Acertada' ? 'bg-success' : prediction.estado === 'Fallada' ? 'bg-danger' : 'bg-warning text-dark' %>">
                Estado: <%= prediction.estado %>
            </span>
        </div>

        <div class="card-body p-4 p-md-5">
            <!-- Si ya hay resultado real -->
            <% if (prediction.golesLocalReal !== null && prediction.golesVisitanteReal !== null) { %>
                <div class="alert alert-secondary text-center p-3 mb-4 rounded-3">
                    <h5 class="mb-1"><i class="bi bi-flag-fill text-warning me-2"></i>Resultado Final Oficial</h5>
                    <div class="fs-4 fw-bold">
                        <%= prediction.equipoLocal %> <%= prediction.golesLocalReal %> - <%= prediction.golesVisitanteReal %> <%= prediction.equipoVisitante %>
                    </div>
                    <div class="small text-muted mt-1">
                        El pronóstico recomendado era: <strong><%= prediction.pronosticoRecomendado %></strong>
                    </div>
                </div>
            <% } %>

            <!-- Distribución de Probabilidades -->
            <h5 class="fw-semibold text-light mb-3">
                <i class="bi bi-pie-chart-fill text-success me-2"></i> Probabilidades Estadísticas
            </h5>
            <div class="p-3 bg-dark rounded-3 border border-secondary border-opacity-25 mb-4">
                <div class="row text-center mb-2">
                    <div class="col-4">
                        <span class="text-success fw-bold fs-4"><%= prediction.probabilidadLocal %>%</span>
                        <div class="text-muted small">Victoria Local</div>
                    </div>
                    <div class="col-4">
                        <span class="text-secondary fw-bold fs-4"><%= prediction.probabilidadEmpate %>%</span>
                        <div class="text-muted small">Empate</div>
                    </div>
                    <div class="col-4">
                        <span class="text-info fw-bold fs-4"><%= prediction.probabilidadVisitante %>%</span>
                        <div class="text-muted small">Victoria Visitante</div>
                    </div>
                </div>
                <div class="progress" style="height: 12px;">
                    <div class="progress-bar bg-success" style="width: <%= prediction.probabilidadLocal %>%"></div>
                    <div class="progress-bar bg-secondary" style="width: <%= prediction.probabilidadEmpate %>%"></div>
                    <div class="progress-bar bg-info" style="width: <%= prediction.probabilidadVisitante %>%"></div>
                </div>
            </div>

            <!-- Factores y Análisis -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="card bg-dark border-secondary border-opacity-25 h-100 p-3">
                        <h6 class="text-warning fw-semibold"><i class="bi bi-key-fill me-1"></i> Factor Clave</h6>
                        <p class="text-muted mb-0"><%= prediction.factorClave %></p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-dark border-secondary border-opacity-25 h-100 p-3">
                        <h6 class="text-info fw-semibold"><i class="bi bi-check2-circle me-1"></i> Pronóstico Recomendado</h6>
                        <p class="text-light fs-5 fw-bold mb-0"><%= prediction.pronosticoRecomendado %></p>
                    </div>
                </div>
                <div class="col-12">
                    <div class="card bg-dark border-secondary border-opacity-25 p-3">
                        <h6 class="text-success fw-semibold"><i class="bi bi-chat-quote-fill me-1"></i> Análisis del Modelo</h6>
                        <p class="text-light mb-0"><%= prediction.analisis %></p>
                    </div>
                </div>
            </div>

            <!-- Metadatos NoSQL / MongoDB -->
            <div class="d-flex flex-wrap justify-content-between align-items-center text-muted extra-small pt-3 border-top border-secondary border-opacity-25">
                <div>
                    <i class="bi bi-database me-1"></i> ID Documento MongoDB: <code><%= prediction._id %></code>
                </div>
                <div>
                    Registrado el: <%= new Date(prediction.createdAt).toLocaleString('es-ES') %>
                </div>
            </div>

            <!-- Acciones -->
            <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="/predictions/<%= prediction._id %>/edit" class="btn btn-warning text-dark px-4 fw-semibold">
                    <i class="bi bi-pencil-square me-1"></i> Editar / Cargar Resultado
                </a>
                <form action="/predictions/<%= prediction._id %>?_method=DELETE" method="POST" onsubmit="return confirm('¿Seguro que deseas eliminar este pronóstico?')">
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-trash3 me-1"></i> Eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
