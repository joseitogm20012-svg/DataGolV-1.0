<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container my-5 text-center flex-grow-1">
    <div class="card bg-dark-subtle border-danger border-opacity-50 p-5 rounded-4 shadow mx-auto" style="max-width: 600px;">
        <i class="bi bi-exclamation-octagon-fill text-danger display-1 mb-3"></i>
        <h2 class="fw-bold mb-2"><%= title || 'Ocurrió un Error' %></h2>
        <p class="text-muted mb-4"><%= mensaje || 'Ha ocurrido un error inesperado al procesar la solicitud.' %></p>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="text-start bg-dark p-3 rounded text-danger small mb-4 font-monospace overflow-auto">
                <%= error.message || error %>
            </div>
        <% } %>

        <div>
            <a href="/" class="btn btn-success px-4 rounded-pill">
                <i class="bi bi-house-door-fill me-1"></i> Volver al Inicio
            </a>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
